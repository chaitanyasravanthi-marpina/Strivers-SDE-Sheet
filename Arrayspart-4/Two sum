class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int n = nums.size();
        map<int,int>s;
        int nums2;
        for(int i = 0;i<n;i++){
            nums2 = target-nums[i];
            if(s.find(nums2) != s.end()){
              return {s[nums2],i};
            }
            s[nums[i]] = i;

        }
        return {};
        
    }
};
