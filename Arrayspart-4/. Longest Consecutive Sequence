class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        
        sort(nums.begin(),nums.end());
        int n= nums.size();
        if (n<=1) return n;
        int res = 1;
        int count = 1;
        for(int i=0;i<n-1;i++){
            if(nums[i] == nums[i+1]-1 ){
                count += 1;
                res = max(res,count);
            }
            else if(nums[i] == nums[i+1]){
                continue;
            }
            else{
                count = 1;
            }
           
          
        }
        return res;
        
    }
};
