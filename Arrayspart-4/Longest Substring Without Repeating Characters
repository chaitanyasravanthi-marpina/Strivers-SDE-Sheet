class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_map<char,int> seen;
        int n = s.size();
        int l =0 ,r=0,maxlen = 0;
        for(int r = 0;r<s.size();r++){
            if(seen.find(s[r]) != seen.end() && seen[s[r]] >=l){
                l = seen[s[r]]+1;
            }
            seen[s[r]] =r;
            maxlen = max(maxlen,r-l+1);
        }
        return maxlen;
       
    }
};
