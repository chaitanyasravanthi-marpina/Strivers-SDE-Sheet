class Solution{
public:
    int longestSubarray(vector<int> &nums, int k){
        int n = nums.size();
        unordered_map<int,int>hash;
        int sum = 0;
         int len =0;
            int maxlen = 0;
        for(int i =0;i<n;i++){
            sum += nums[i];
            if(sum == k) return i+1;
           
            if(hash.find(sum-k) != hash.end()){
                len = i-hash[sum-k];
                maxlen = max(len,maxlen);
            }
            else{
            hash[sum] = i;
            }
            return maxlen;


        }
        
    }
};
