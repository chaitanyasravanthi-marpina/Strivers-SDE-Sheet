class Solution {
public:
    int subarraysXor(vector<int> &arr, int k) {

        unordered_map<int,int> mp;

        mp[0] = 1;

        int xr = 0;
        int count = 0;

        for(int x : arr){

            xr ^= x;

            count += mp[xr ^ k];

            mp[xr]++;
        }

        return count;
    }
};
